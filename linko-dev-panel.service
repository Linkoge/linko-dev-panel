[Unit]
Description=Private multi-project Git development panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/dev-panel
ExecStart=/usr/bin/python3 %h/projects/dev-panel/server.py
Environment=PYTHONUNBUFFERED=1
Environment=LINKO_PANEL_HOST=127.0.0.1
Environment=LINKO_PANEL_PORT=8765
Restart=on-failure
RestartSec=3
# tmux owns persistent sessions, including across panel service restarts.
KillMode=process

[Install]
WantedBy=default.target
